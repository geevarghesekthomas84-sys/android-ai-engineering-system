# ============================================================
# Android AI Engineering System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=demoapp
POSTGRES_USER=demouser
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# --- Backend ---
DATABASE_URL=postgresql://demouser:CHANGE_ME@localhost:5432/demoapp
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_STRING_AT_LEAST_32_CHARS
NODE_ENV=development
PORT=3000

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Android SDK (optional, auto-detected on most systems) ---
# ANDROID_HOME=/path/to/android/sdk
# ANDROID_CLI_HOME=/path/to/android-cli/data
